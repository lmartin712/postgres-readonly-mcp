# Copy to .env and export in your shell, or put the values in the "env" block
# of claude_desktop_config.json. The server reads real environment variables only.

# Connection string. Use a dedicated role that only has SELECT grants.
PG_DSN=postgresql://mcp_reader:demo_reader_pw@localhost:55432/invoicing_demo

# Comma-separated list. "customers" means public.customers; "sales.invoices" is schema-qualified.
MCP_ALLOWED_TABLES=customers,invoices,invoice_lines

# Maximum rows returned per query (the server fetches at most this many + 1).
MCP_ROW_LIMIT=200

# Per-statement timeout in milliseconds.
MCP_STATEMENT_TIMEOUT_MS=5000

# JSONL audit log (use an absolute path when launched from Claude Desktop).
MCP_AUDIT_LOG=./logs/audit.jsonl
